PKG=connman-ui_0~20150623.orig.tar.gz
URL=https://deb.debian.org/debian/pool/main/c/connman-ui/${PKG}

download() {
    [ -f "$PKG" ] || wget -t 3 -T 60 -O "$PKG" "$URL"
}

build() {
    mkdir connman-ui
    tar -xzf "$PKG" -C connman-ui --strip-components=1
    cd connman-ui
    patch -p1 < ../grab.patch
    patch -p1 < ../no-label.patch
    ./autogen.sh
    ./configure --prefix=/usr
    make install

    for ICON in /usr/share/connman_ui_gtk/icons/*.png; do
        [ -f ../${ICON%.png}.svg ] || continue
        rm -f ${ICON}
    done
}