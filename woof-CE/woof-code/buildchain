#!/bin/bash

set -euo pipefail

if [ ! -d "./_slogs" ]; then
    echo "Creating log directory"
    mkdir -p ./_slogs
else
    echo "Clearing log directory..."
    rm -rf ./_slogs
    mkdir -p ./_slogs
fi

echo "[1/4] Running 0setup..."
./0setup 2>&1 | tee ./_slogs/0setup.log

echo "[2/4] Running 1download..."
./1download 2>&1 | tee ./_slogs/1download.log

echo "[3/4] Running 2createpackages..."
./2createpackages -all 2>&1 | tee ./_slogs/2createpackages.log

echo "[4/4] Running 3builddistro-Z..."

# By default choose foosapup kernel
./3builddistro-Z 2>&1 | tee ./_slogs/3builddistro.log

echo "Build completed successfully."